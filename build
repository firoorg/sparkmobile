#!/usr/bin/env bash
set -e

if [ "$#" -ne 1 ] || [ -z "$1" ]; then
  echo "Please supply a directory for the test executables"
  exit 1
fi

output_dir=$1
if [ -e "$output_dir" ] && [ ! -d "$output_dir" ]; then
  echo "$output_dir exists and is not a directory"
  exit 1
fi

if [ ! -f "secp256k1/Makefile" ]; then
  (
    cd "secp256k1"
    ./autogen.sh
    ./configure --enable-experimental --enable-module-ecdh --with-bignum=no --enable-endomorphism
  )
fi
make -C "secp256k1" -j"${JOBS:-4}"

mkdir -p "$output_dir/obj"

common_sources=(src/*.cpp bitcoin/*.cpp bitcoin/support/*.cpp bitcoin/crypto/*.cpp)
common_objects=()
for source in "${common_sources[@]}"; do
  object="$output_dir/obj/${source//\//_}.o"
  g++ -c "$source" -g -Isecp256k1/include -std=c++17 -o "$object"
  common_objects+=("$object")
done
rm -f "$output_dir/libsparkmobile.a"
ar rcs "$output_dir/libsparkmobile.a" "${common_objects[@]}"

tests=(
  "spark_test spark_tests"
  "spark_name_test spark_name_tests"
  "address_test address_tests"
  "ownership_test ownership_tests"
  "coin_test spark_coin_tests"
  "aead_test spark_aead_tests"
  "bpplus_test spark_bpplus_tests"
  "chaum_test spark_chaum_tests"
  "encrypt_test spark_encrypt_tests"
  "f4grumble_test spark_f4grumble_tests"
  "grootle_test spark_grootle_tests"
  "mint_transaction_test spark_mint_transaction_tests"
  "schnorr_test spark_schnorr_tests"
  "spend_transaction_test spark_spend_transaction_tests"
  "transcript_test spark_transcript_tests"
  "full_test full_test"
)

for test in "${tests[@]}"; do
  read -r source executable <<< "$test"
  echo "Building $executable"
  g++ "tests/$source.cpp" "$output_dir/libsparkmobile.a" \
    -g -Isecp256k1/include secp256k1/.libs/libsecp256k1.a \
    -lssl -lcrypto -lpthread -l"${BOOST_TEST_LIB:-boost_unit_test_framework}" -std=c++17 \
    -o "$output_dir/$executable"
done
